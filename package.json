{
  "name": "ouahad-hidden-data",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/run-next.mjs dev",
    "build": "node scripts/run-next.mjs build",
    "start": "node scripts/run-next.mjs start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test-unit.mjs",
    "test:all": "node scripts/test-unit.mjs --all",
    "test:browser": "playwright test",
    "format": "prettier --write src tests *.ts *.mjs *.json",
    "postbuild": "node scripts/verify-release.mjs",
    "prestart": "node scripts/verify-release.mjs",
    "dev:research": "node scripts/run-next.mjs dev research --port 3002",
    "build:research": "node scripts/run-next.mjs build research",
    "start:research": "node scripts/run-next.mjs start research",
    "test:research": "playwright test --config playwright.research.config.ts"
  },
  "dependencies": {
    "exifreader": "^4.50.0",
    "lucide-react": "^0.468.0",
    "next": "^16.4.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@huggingface/transformers": "4.3.1",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.4.2",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
